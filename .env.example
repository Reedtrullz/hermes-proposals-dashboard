HERMES_HOME=/data/hermes
HERMES_REQUIRE_AUTH=1
# Trusted Auth.js issuer origin (HTTPS), never derived from incoming requests:
AUTH_URL=https://reidar.tech
# Set at least one verified owner identity (both must match when both provided):
OWNER_GITHUB_ID=
OWNER_EMAIL=
# Optional machine credential: >=32 ASCII chars, securely generated and kept private.
# Without it, machine access is disabled. It never grants browser/admin access.
HERMES_API_KEY=
